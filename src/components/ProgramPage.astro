---
/**
 * Программа одного дня. Вся сетка, карточки, табы, чипы и счётчик рендерятся
 * на билде: страница читается и печатается без JS. Клиентский скрипт только
 * фильтрует, открывает модалку, помнит избранное и собирает `.ics`.
 */
import { dayLabel, dayLongLabel, pluralDays, pluralTalks } from "../i18n/format";
import { dayHrefFor } from "../i18n/paths";
import { t, type Lang } from "../i18n/ui";
import { hallLabel, dayNameLabel, localizeTalk, trackLabel } from "../lib/localize";
import {
  PROGRAM,
  days,
  firstBanner,
  hallsOfDay,
  isPlaceable,
  occupiedCells,
  placeTalks,
  startsOf,
  talksOfDay,
  tracksOfProgram,
  type Day,
  type PlacedTalk,
} from "../lib/program";
import SearchDialog from "./SearchDialog.astro";
import TalkCard from "./TalkCard.astro";
import TalkModal from "./TalkModal.astro";
import "../styles/program.css";

interface Props {
  day: Day;
  ordinal: number;
  lang: Lang;
}

const { day, ordinal, lang } = Astro.props;

const allDays = days();
const dayTalks = talksOfDay(day);
const halls = hallsOfDay(day, dayTalks);
const placeable = dayTalks.filter((talk) => isPlaceable(talk, halls));
const rows = startsOf(placeable);
const { slots } = placeTalks(placeable, halls, rows);
const taken = occupiedCells(slots);
const slotMap = new Map(
  slots.map((slot) => [`${slot.row - 1}:${slot.column - 2}`, slot] as const),
);

type Cell =
  | { kind: "time"; row: number; time: string }
  | { kind: "talk"; slot: PlacedTalk }
  | { kind: "empty"; row: number; column: number };

/** Плоский список ячеек: строки, время и пустышки в одном проходе. */
const cells: Cell[] = [];
for (let row = 0; row < rows.length; row += 1) {
  cells.push({ kind: "time", row: row + 1, time: rows[row] as string });
  for (let column = 0; column < halls.length; column += 1) {
    const slot = slotMap.get(`${row}:${column}`);
    if (slot) {
      cells.push({ kind: "talk", slot });
      continue;
    }
    // Ячейка внутри чужого `span` уже занята карточкой — пустышку не рисуем,
    // иначе она наложится на неё и съест клик.
    if (taken.has(`${row}:${column}`)) continue;
    cells.push({ kind: "empty", row: row + 1, column: column + 2 });
  }
}

const total = slots.length;
/**
 * Первый баннер в порядке сетки — он же LCP на десктопе. Приоритет отдаётся
 * `fetchpriority` + `preload` из `Base.astro`; сама картинка остаётся `lazy`,
 * потому что страница дня весит десятки мегабайт чужих баннеров.
 */
const firstBannerId = firstBanner(day)?.id ?? -1;
const trackChips = tracksOfProgram().map((track) => ({
  track,
  count: placeable.filter((talk) => talk.track === track).length,
}));

const trackCount = tracksOfProgram().length;
const hallCount = PROGRAM.halls.length;
// Числительных для «треков»/«залов» в словаре нет: английская форма одна на
// любое число, русская сохраняет прежнюю подпись побайтово.
const tracksFact = lang === "en" ? `${trackCount} tracks` : `${trackCount} треков`;
const hallsFact = lang === "en" ? `${hallCount} halls` : `${hallCount} залов`;
---

<header class="page-head">
  <p class="eyebrow">{t(lang, "brandEvent")} · {dayLongLabel(day.date, lang)}</p>
  <h1 class="page-title">{t(lang, "pageTitle")}</h1>
  <p class="page-intro">
    {
      t(lang, "introLine", {
        day: dayNameLabel(lang, day.name),
        n: total,
        talks: pluralTalks(total, lang),
        halls: halls.length,
      })
    }
  </p>
  <dl class="facts">
    <div class="facts__item facts__item--duration">
      <dt>{t(lang, "factsDuration")}</dt>
      <dd>{allDays.length} {pluralDays(allDays.length, lang)}</dd>
    </div>
    <div class="facts__item facts__item--talks">
      <dt>{t(lang, "factsTalks")}</dt>
      <dd>{PROGRAM.talks.length} {pluralTalks(PROGRAM.talks.length, lang)}</dd>
    </div>
    <div class="facts__item facts__item--tracks">
      <dt>{t(lang, "factsTracks")}</dt>
      <dd>{tracksFact}</dd>
    </div>
    <div class="facts__item facts__item--halls">
      <dt>{t(lang, "factsHalls")}</dt>
      <dd>{hallsFact}</dd>
    </div>
  </dl>
</header>

<nav class="day-tabs" data-day-tabs aria-label={t(lang, "dayTabsLabel")}>
  {
    allDays.map((item, index) => {
      const value = index + 1;
      const current = value === ordinal;
      return (
        <a
          class:list={["day-tab", current ? "day-tab--active" : null]}
          href={dayHrefFor(lang, value)}
          aria-current={current ? "page" : undefined}
        >
          <span class="day-tab__num">{dayNameLabel(lang, item.name)}</span>
          <span class="day-tab__date">{dayLabel(item.date, lang)}</span>
        </a>
      );
    })
  }
</nav>

<div class="program-toolbar">
  <div class="track-chips" data-track-chips role="group" aria-label={t(lang, "trackFiltersLabel")}>
    {/* Избранное — второй, независимый от трека фильтр. Стоит первым и намеренно
        не несёт `data-track`: селектор чипов трека его не подхватывает, а
        счётчик избранного обновляет клиент вместе с `[data-favorites-count]`.
        Без JS чип читается как выключенный переключатель с нулём. */}
    <button class="track-chip" type="button" data-fav-filter aria-pressed="false">
      <span class="track-chip__name">{t(lang, "favoritesChip")}</span>
      <span class="track-chip__count" data-fav-filter-count>0</span>
    </button>
    {
      trackChips.map((chip) => (
        <button class="track-chip" type="button" data-track={chip.track} aria-pressed="false">
          <span class="track-chip__name">{trackLabel(lang, chip.track)}</span>
          <span class="track-chip__count">{chip.count}</span>
        </button>
      ))
    }
    {/* Телефонный выбор трека: 12 подписей — 2147px, в строку 358px не влезают,
        а перенос даёт 8 строк над карточками. Обёртка выглядит чипом, но тап
        открывает системный список; `<select>` прозрачный и лежит поверх.
        Значение пишет клиент (`.track-select__value`), как и `aria-pressed`
        чипов — оба вида читают одно состояние `activeTrack`. */}
    <label class="track-select">
      <span class="track-select__value" data-track-select-value>{t(lang, "allTracks")}</span>
      <select class="track-select__control" data-track-select aria-label={t(lang, "trackSelectLabel")}>
        <option value="">{t(lang, "allTracks")}</option>
        {trackChips.map((chip) => (
          <option value={chip.track}>
            {trackLabel(lang, chip.track)} · {chip.count}
          </option>
        ))}
      </select>
    </label>
  </div>

  {/* `aria-live` на самом счётчике: фильтр переписывает число и слово без
      перерисовки сетки, и без live-региона скринридер молчит о результате. */}
  <p class="talk-count" aria-live="polite">
    <span data-talk-count>{total}</span>
    <span data-talk-count-label>{pluralTalks(total, lang)}</span>
  </p>

  <button class="button button--ghost" type="button" data-export-ics>
    {t(lang, "exportIcs")}
  </button>
</div>

<section class="program-grid" data-grid aria-labelledby="schedule-title" style={`--mm-hall-count:${halls.length}`}>
  {/* Уровень h2 обязателен: без него заголовки карточек (h3) идут сразу после
      h1, и скринридер видит пропуск уровня на всех трёх страницах. Заголовок
      скрыт визуально: заголовок страницы и табы уже задают контекст. */}
  <h2 class="visually-hidden" id="schedule-title">{t(lang, "scheduleTitle")}</h2>
  <div class="program-grid__halls-header">
    <div class="program-grid__time-label">{t(lang, "timeHeader")}</div>
    {halls.map((hall) => <div class="program-grid__hall-name">{hallLabel(lang, hall)}</div>)}
  </div>

  <div class="program-grid__content">
    {
      cells.map((cell) => {
        if (cell.kind === "time") {
          return (
            <div class="program-grid__time-cell" style={`grid-area:${cell.row} / 1`}>
              {cell.time}
            </div>
          );
        }
        if (cell.kind === "empty") {
          return (
            <div
              class="program-grid__talk-cell"
              style={`grid-area:${cell.row} / ${cell.column} / span 1`}
            />
          );
        }
        return (
          <div
            class="program-grid__talk-cell"
            data-track={cell.slot.talk.track}
            data-span={cell.slot.span > 1 ? cell.slot.span : undefined}
            style={`grid-area:${cell.slot.row} / ${cell.slot.column} / span ${cell.slot.span}`}
          >
            <TalkCard
              talk={localizeTalk(lang, cell.slot.talk)}
              trackKey={cell.slot.talk.track}
              lang={lang}
              priority={cell.slot.talk.id === firstBannerId}
            />
          </div>
        );
      })
    }
  </div>
</section>

<p class="program-empty" data-empty hidden>
  {t(lang, "emptyTrack")}
</p>

<TalkModal lang={lang} />
<SearchDialog lang={lang} />

<script>
  import "../scripts/program-client.ts";
</script>

<style>
  /* Счётчик в чипе — вторичная информация: имя трека читается первым.
     Разделитель рисуем псевдоэлементом, чтобы не плодить текстовые узлы. */
  .track-chip__count {
    margin-inline-start: 0.15em;
    font-variant-numeric: tabular-nums;
    opacity: 0.7;
  }

  .track-chip__count::before {
    content: "·";
    margin-inline: 0.3em 0.15em;
    opacity: 0.7;
  }
</style>
