---
/**
 * Панель меню (`nav#site-nav`) и подложка. Вынесена из `Nav.astro` отдельным
 * компонентом: шапка и панель не делят ни одной строки разметки, а вместе они
 * переваливали за бюджет 20 КБ на файл. Всё, что панели нужно, приходит пропами —
 * включая адрес бренда, чтобы компонент не знал про UTM-разметку шапки.
 */
import { t, type Lang } from "../i18n/ui";
import { THEME_PATHS } from "../lib/theme";

interface Props {
  lang: Lang;
  langHref: string;
  targetLang: Lang;
  langCode: string;
  page: "day" | "talks" | "talk";
  ordinal?: number;
  dayLinks: { ordinal: number; href: string; label: string }[];
  siteLinks: { href: string; label: string; icon: string }[];
  talksHref: string;
  favorites: boolean;
  ics: boolean;
  brandHref: string;
}

const {
  lang,
  langHref,
  targetLang,
  langCode,
  page,
  ordinal,
  dayLinks,
  siteLinks,
  talksHref,
  favorites,
  ics,
  brandHref,
} = Astro.props;
---
<div class="nav-scrim" data-nav-close></div>

<nav id="site-nav" aria-label={t(lang, "navMenuLabel")}>
  <div class="drawer-head">
    <a class="nav-brand" href={brandHref}>
      <span class="nav-brand-icon" aria-hidden="true"></span>
      <span class="nav-brand-text">
        <b>{t(lang, "brandName")}</b>
        <span class="nav-brand-role">{t(lang, "brandRole")}</span>
      </span>
    </a>
    <button class="drawer-close" type="button" data-nav-close aria-label={t(lang, "navClose")}>
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <ul class="drawer-links">
    {
      dayLinks.map((link) => (
        <li>
          <a
            class:list={["drawer-link", "drawer-link--day", link.ordinal === ordinal ? "is-current" : null]}
            href={link.href}
            aria-current={link.ordinal === ordinal ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a
        class="drawer-link drawer-link--talks"
        href={talksHref}
        aria-current={page === "talks" ? "page" : undefined}
      >
        {t(lang, "navTalks")}
      </a>
    </li>
    {
      siteLinks.map((link) => (
        <li>
          <a class={`drawer-link drawer-link--${link.icon}`} href={link.href} rel="noopener">{link.label}</a>
        </li>
      ))
    }
  </ul>

  <div class="drawer-foot">
    {/* Не подпись, а кнопка: из панели избранное открывается одним тапом.
        Счётчик остаётся тем же `data-favorites-count`, его обновляет клиент. */}
    {favorites && (
    <button
      class="drawer-favs"
      type="button"
      data-fav-drawer
      aria-pressed="false"
      aria-label={t(lang, "navFavoritesOpen")}
      title={t(lang, "navFavoritesOpen")}
    >
      <span>{t(lang, "navFavorites")}</span>
      <span class="drawer-favs__tail">
        <span class="drawer-favs__count" data-favorites-count>0</span>
        <svg
          class="drawer-favs__arrow"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M9 6l6 6-6 6"></path>
        </svg>
      </span>
    </button>
    )}
    {/* Экспорт переехал из тулбара: там он стоял третьим элементом и на
        телефоне делил строку со счётчиком. В панели кнопка не конкурирует за
        ширину, а качает тот же набор — видимые после фильтров доклады. */}
    {ics && (
      <button class="drawer-ics" type="button" data-export-ics>
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M7 10l5 5 5-5M12 15V3"></path>
        </svg>
        <span>{t(lang, "exportIcs")}</span>
      </button>
    )}
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={t(lang, "navThemeToggle")}>
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d={THEME_PATHS.dark}></path>
      </svg>
      <span>{t(lang, "navThemeToggle")}</span>
    </button>
    <a
      class="nav-icon-btn nav-lang"
      href={langHref}
      hreflang={targetLang}
      lang={targetLang}
      aria-label={t(lang, "langSwitch")}
      title={t(lang, "langSwitch")}
    >
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20"></path>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
        ></path>
      </svg>
      <span>{langCode}</span>
    </a>
  </div>
</nav>

