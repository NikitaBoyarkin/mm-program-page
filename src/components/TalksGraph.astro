---
/**
 * Граф рисуется на билде: SVG, ни одного клиентского скрипта. Координаты
 * приходят из `layoutGraph` — детерминированной раскладки колец (см.
 * `lib/talks-graph.ts`), поэтому один слепок даёт один и тот же рисунок.
 *
 * Точка на дуге — это ссылка на заметку (`/talk/309/`), а не декоративная
 * точка: переход к тексту доклада — единственный интерактив, который требует
 * браузера. Подсветка трека при наведении и фокусе сделана на `:has()` и без
 * скрипта: заметки сгруппированы по хабу, `g.talks-graph__cluster`. */
import { themeLabel, themeShortLabel, type GraphLayout } from "../lib/talks-graph";
import { trackLabel } from "../lib/localize";
import { THEME_CHAR_W, TRACK_CHAR_W, placeLabels, round2, type Claim } from "../lib/talks-labels";
import { t, type Lang } from "../i18n/ui";

interface Props {
  layout: GraphLayout;
  lang: Lang;
  /** Заголовки заметок на языке страницы: `<title>` точки — не подсказка ради
   *  подсказки, по нему скринридер читает ссылку. */
  titles: Map<number, string>;
}

const { layout, lang, titles } = Astro.props;

/** Подпись хаба: у темы словарь один, у трека имя приходит из слепка и
 *  переводится overlay'ем. */
const hubLabel = (hub: GraphLayout["hubs"][number]): string => {
  if (hub.kind === "event") return hub.label;
  if (hub.kind === "theme") return themeLabel(hub.key.replace("theme:", ""), lang);
  return trackLabel(lang, hub.label);
};

/** Подпись на кольце: у темы — короткая форма, у трека — имя целиком (оно
 *  короче и живёт на внешнем кольце, где места больше). */
const ringLabel = (hub: GraphLayout["hubs"][number]): string =>
  hub.kind === "theme" ? themeShortLabel(hub.key.replace("theme:", ""), lang) : hubLabel(hub);


const themeHubs = layout.hubs.filter((hub) => hub.kind === "theme");
const trackHubs = layout.hubs.filter((hub) => hub.kind === "track");
const eventHub = layout.hubs.find((hub) => hub.kind === "event");

/** Дуга-скобка «этот отрезок точки несёт этот трек». Девяносто две спицы
 *  рисовали серую шубу и спорили с рёбрами; одна скобка на трек говорит то же
 *  самое, но читается как граница участка. Радиус — между кольцом треков (246)
 *  и дугой заметок (296). */
const BRACKET_R = 272;
const arcPath = (start: number, end: number): string => {
  const at = (angle: number) =>
    `${round2(layout.width / 2 + Math.cos(angle) * BRACKET_R)} ${round2(layout.height / 2 + Math.sin(angle) * BRACKET_R)}`;
  return `M ${at(start)} A ${BRACKET_R} ${BRACKET_R} 0 0 1 ${at(end)}`;
};
// Круги хабов занимают место до подписей: иначе подпись садилась поверх узла.
const claimed: Claim[] = layout.hubs.map((hub) => ({
  key: hub.key,
  box: { x0: hub.x - hub.radius, x1: hub.x + hub.radius, y0: hub.y - hub.radius, y1: hub.y + hub.radius },
}));

// Темы первыми: их подписи короче и живут на внутреннем кольце, треки
// обходят уже занятые прямоугольники.
const themeLabels = placeLabels(
  themeHubs,
  { direction: 1, maxLength: 14, charWidth: THEME_CHAR_W },
  claimed,
  ringLabel,
);

const trackLabels = placeLabels(
  trackHubs,
  // 20, а не 24: «Маркетинговая аналитика» занимала 176 px у нижнего полюса и
  // перекрывала все полосы соседей — полное имя остаётся в `<title>` и в
  // заголовке трека ниже.
  { direction: -1, maxLength: 20, charWidth: TRACK_CHAR_W },
  claimed,
  ringLabel,
);

// Заметки сгруппированы по треку: `:has()` на этом и держит подсветку кластера.
// Порядок — порядок раскладки (трек за треком), поэтому итерация `Map`
// детерминирована.
const notesByHub = new Map<string, GraphLayout["notes"]>();
for (const note of layout.notes) {
  const bucket = notesByHub.get(note.hubKey);
  if (bucket) bucket.push(note);
  else notesByHub.set(note.hubKey, [note]);
}

const hubByKey = new Map(layout.hubs.map((hub) => [hub.key, hub]));
const edgeTitle = (edge: GraphLayout["edges"][number]): string => {
  const from = hubByKey.get(edge.from);
  const to = hubByKey.get(edge.to);
  if (!from || !to) return String(edge.weight);
  return `${hubLabel(from)} — ${hubLabel(to)} · ${edge.weight}`;
};
---

<a class="talks-graph__skip" href="#talks-notes-title">{t(lang, "talksSkipGraph")}</a>

<figure class="talks-graph">
  <div class="talks-graph__canvas">
    <svg
      class="talks-graph__svg"
      viewBox={`0 0 ${layout.width} ${layout.height}`}
      role="group"
      aria-label={t(lang, "talksGraphAria")}
      preserveAspectRatio="xMidYMid meet"
    >
      {/* Скобки участков: показывают, какие точки на дуге выросли из какого
          трека. Тоньше любого смыслового ребра — это членство, а не связь. */}
      <g class="talks-graph__arcs" aria-hidden="true">
        {
          trackHubs.map((hub) =>
            hub.arcStart === undefined || hub.arcEnd === undefined ? null : (
              <path d={arcPath(hub.arcStart, hub.arcEnd)} />
            ),
          )
        }
      </g>

      {/* Рёбра: тонкий пунктир — иерархия «событие → трек», акцентные — пересечение
          «трек ↔ тема», толщина которого равна числу общих докладов. */}
      <g class="talks-graph__edges" aria-hidden="true">
        {
          layout.edges.map((edge) => (
            <line
              class:list={[
                "talks-graph__edge",
                `talks-graph__edge--${edge.kind}`,
                edge.weight === 1 && "talks-graph__edge--single",
              ]}
              x1={edge.x1}
              y1={edge.y1}
              x2={edge.x2}
              y2={edge.y2}
              style={`--edge-width:${edge.width.toFixed(2)}`}
            >
              <title>{edgeTitle(edge)}</title>
            </line>
          ))
        }
      </g>

      {/* Выноски: подпись, уехавшая от узла больше чем на 12 px, получает
          тонкую линию. Только у оторванных — у остальных соседство и так
          очевидно, а 23 линии превратились бы в паутину. */}
      <g class="talks-graph__leaders" aria-hidden="true">
        {
          [...themeLabels, ...trackLabels].map(({ leader }) =>
            leader ? <line x1={leader.x1} y1={leader.y1} x2={leader.x2} y2={leader.y2} /> : null,
          )
        }
      </g>

      <g class="talks-graph__hubs">
        {
          eventHub && (
            <>
              <circle class="talks-graph__hub talks-graph__hub--event" cx={eventHub.x} cy={eventHub.y} r={eventHub.radius}>
                <title>{`${eventHub.label} · ${eventHub.count}`}</title>
              </circle>
              <text class="talks-graph__hub-count talks-graph__hub-count--event" x={eventHub.x} y={eventHub.y}>
                {eventHub.count}
              </text>
            </>
          )
        }
        {
          themeLabels.map(({ hub, text, x, y, anchor }) => (
            <a class="talks-graph__hub-link" href={`#theme-${hub.key.replace("theme:", "")}`}>
              <circle
                class="talks-graph__hub talks-graph__hub--theme"
                cx={hub.x}
                cy={hub.y}
                r={hub.radius}
              >
                <title>{`${hubLabel(hub)} · ${hub.count}`}</title>
              </circle>
              {/* Число внутри круга: размер и так кодирует количество, но про
                  то, что «AI» несёт 9 докладов, а «Приватность» — 12, по
                  диаметру не прочитать, а суффикс у подписи стоил бы 35 px
                  упаковщика и гнал бы её в полосу перекрытия. */}
              <text class="talks-graph__hub-count" x={hub.x} y={hub.y}>
                {hub.count}
              </text>
              <text
                class="talks-graph__label talks-graph__label--theme"
                x={x}
                y={y}
                text-anchor={anchor}
              >
                {text}
              </text>
            </a>
          ))
        }
        {
          trackLabels.map(({ hub, text, x, y, anchor }) => (
            <>
              <circle
                class="talks-graph__hub talks-graph__hub--track"
                cx={hub.x}
                cy={hub.y}
                r={hub.radius}
              >
                <title>{`${hubLabel(hub)} · ${hub.count}`}</title>
              </circle>
              <text class="talks-graph__hub-count" x={hub.x} y={hub.y}>
                {hub.count}
              </text>
              {/* Подпись трека — внутрь кольца: снаружи она садилась на дугу
                  заметок и на соседнюю тему, а у правого края обрезалась
                  границей viewBox. Радиусы перебирает пакер выше. */}
              <text
                class="talks-graph__label talks-graph__label--track"
                x={x}
                y={y}
                text-anchor={anchor}
              >
                {text}
              </text>
            </>
          ))
        }
      </g>

      <g class="talks-graph__notes">
        {
          [...notesByHub.entries()].map(([hubKey, bucket]) => (
            <g class="talks-graph__cluster" data-hub={hubKey}>
              {bucket.map((note) => (
                <a class="talks-graph__note" href={note.hrefTalk}>
                  <title>{`${note.start} · ${titles.get(note.id) ?? note.title}`}</title>
                  <circle cx={note.x} cy={note.y} r="4.5" />
                  <circle class="talks-graph__note-hit" cx={note.x} cy={note.y} r="13" />
                </a>
              ))}
            </g>
          ))
        }
      </g>
    </svg>
  </div>
  <figcaption class="talks-graph__caption">{t(lang, "talksGraphCaption")}</figcaption>
</figure>
