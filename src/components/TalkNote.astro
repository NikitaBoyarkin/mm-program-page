---
/**
 * Тело страницы доклада — одно на оба языка, чтобы RU и EN не разошлись.
 *
 * Факты (день, время, зал, трек, спикеры) берутся из `PROGRAM`, а не из
 * frontmatter заметки: слепок остаётся единственным источником данных, а
 * frontmatter — его проверяемая копия для редактора. Тело (`<slot />`) —
 * из `.md`: сначала seed из описания, потом ручная правка.
 */
import { t, type Lang } from "../i18n/ui";
import { dayLabel, dayLongLabel } from "../i18n/format";
import type { Talk } from "../lib/program-core";
import type { TalkMaterials } from "../lib/materials";
import { SOCIAL_LABELS } from "../lib/socials";
import { UNTRACKED, type RelatedNote } from "../lib/talks-graph";
import { hallLabel, trackLabel } from "../lib/localize";
import "../styles/talk.css";

interface Props {
  talk: Talk;
  lang: Lang;
  dayName: string;
  dayDate: string;
  themes: Array<{ id: string; label: string }>;
  related: RelatedNote[];
  /** `dayId → ISO-дата`: колонка доски подписана датой, а не номером дня. */
  dayDates: Record<number, string>;
  backHref: string;
  /** Видео и статьи авторов: overlay `src/data/materials.json`, join по имени. */
  materials: TalkMaterials;
  /**
   * Есть ли у заметки тело. У докладов без описания (267, 292, 361, 362) в
   * `.md` только frontmatter, и секция «О докладе» превращалась бы в пустой
   * заголовок. Решает страница: она одна видит запись коллекции.
   */
  hasBody?: boolean;
}

const { talk, lang, dayName, dayDate, themes, related, dayDates, backHref, materials, hasBody = true } = Astro.props;
const time = `${talk.start}–${talk.end}`;

/** Колонки доски: дни по дате, внутри — по времени начала. Сортировка по
 *  ISO-дате, а не по `dayOrdinal`: ординал считается по порядку первого
 *  появления доклада в слепке и с порядком дней не совпадает.
 *  Дни без связанных докладов не рисуются: пустая колонка — не место на доске,
 *  а дырка в ней. */
const relatedByDay = [...related]
  .sort(
    (a, b) =>
      (dayDates[a.dayId] ?? "").localeCompare(dayDates[b.dayId] ?? "") ||
      a.dayOrdinal - b.dayOrdinal ||
      a.start.localeCompare(b.start) ||
      a.id - b.id,
  )
  .reduce<Array<{ dayId: number; ordinal: number; date: string; notes: RelatedNote[] }>>((acc, note) => {
    const last = acc[acc.length - 1];
    if (last?.dayId === note.dayId) last.notes.push(note);
    else acc.push({ dayId: note.dayId, ordinal: note.dayOrdinal, date: dayDates[note.dayId] ?? "", notes: [note] });
    return acc;
  }, []);
---

<article
  class="talk-note"
  data-talk-note
  data-talk-id={talk.id}
  data-talk-title={talk.title}
  data-talk-track={talk.track}
  data-talk-track-id={talk.trackId ?? ""}
  data-talk-day-id={talk.dayId}
  data-talk-locale={lang}
>
  <a class="talk-note__back" href={backHref}>← {t(lang, "talksToProgram")}</a>

  <header class="talk-note__head">
    <p class="talk-note__eyebrow">
      <span>{dayName} {dayLabel(dayDate, lang)}</span>
      <span aria-hidden="true">·</span>
      <span>{time}</span>
      <span aria-hidden="true">·</span>
      <span>
        <span class="visually-hidden">{t(lang, "talkHall")}: </span>{talk.hall}
      </span>
    </p>
    <h1 class="talk-note__title">{talk.title}</h1>
    {talk.track && <p class="talk-note__track">{talk.track}</p>}
  </header>

  {talk.lectors.length > 0 && (
    <section class="talk-note__speakers" aria-labelledby="talk-note-speakers">
      <h2 id="talk-note-speakers">{t(lang, "talkSpeakers")}</h2>
      <ul class="talk-note__speaker-list">
        {talk.lectors.map((lector) => (
          <li class="talk-note__speaker">
            <span class="talk-note__speaker-name">{lector.name}</span>
            {lector.role && <span class="talk-note__speaker-role">{lector.role}</span>}
            {lector.socials && lector.socials.length > 0 && (
              <span class="social-links">
                {lector.socials.map((link) => (
                  <a
                    class={`social-link social-link--${link.network}`}
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer nofollow"
                    aria-label={`${SOCIAL_LABELS[link.network]}: ${lector.name}`}
                    title={SOCIAL_LABELS[link.network]}
                    data-analytics="speaker-social"
                    data-speaker={lector.name}
                  ></a>
                ))}
              </span>
            )}
          </li>
        ))}
      </ul>
    </section>
  )}

  {(materials.topic.length > 0 || materials.bySpeaker.length > 0) && (
    <section class="talk-note__materials" aria-labelledby="talk-note-materials">
      <h2 id="talk-note-materials">{t(lang, "talkMaterials")}</h2>
      <ul class="talk-note__material-list">
        {materials.topic.map((item) => (
          <li class="talk-note__material">
            <span class="talk-note__material-kind">
              {t(lang, item.kind === "video" ? "materialVideo" : "materialArticle")}
            </span>
            <a
              class="talk-note__material-link"
              href={item.url}
              target="_blank"
              rel="noopener noreferrer nofollow"
              data-analytics="talk-material"
            >
              {item.title}
            </a>
            <span class="talk-note__material-by">{t(lang, "materialTopic")}</span>
          </li>
        ))}
        {materials.bySpeaker.map((group) =>
          group.items.map((item) => (
            <li class="talk-note__material">
              <span class="talk-note__material-kind">
                {t(lang, item.kind === "video" ? "materialVideo" : "materialArticle")}
              </span>
              <a
                class="talk-note__material-link"
                href={item.url}
                target="_blank"
                rel="noopener noreferrer nofollow"
                data-analytics="talk-material"
              >
                {item.title}
              </a>
              <span class="talk-note__material-by">{group.name}</span>
            </li>
          )),
        )}
      </ul>
    </section>
  )}

  {hasBody && (
    <section class="talk-note__about" aria-labelledby="talk-note-about">
      <h2 id="talk-note-about">{t(lang, "talkAbout")}</h2>
      <div class="talk-note__prose">
        <slot />
      </div>
    </section>
  )}

  {themes.length > 0 && (
    <section class="talk-note__themes" aria-labelledby="talk-note-themes">
      <h2 id="talk-note-themes">{t(lang, "factsThemes")}</h2>
      <ul class="talk-note__chips">
        {themes.map((theme) => <li class="talk-note__chip">{theme.label}</li>)}
      </ul>
    </section>
  )}

  {related.length > 0 && (
    <section class="talk-note__related" aria-labelledby="talk-note-related">
      <h2 id="talk-note-related">{t(lang, "talksRelated")}</h2>
      {/* Доска, а не таблица: у соседа те же факты, что у самой заметки, но
          сравнивают их по дню — «что ещё идёт в этот день». Колонка подписана
          датой, а не «День N»: номер дня ничего не говорит читателю, который
          пришёл из поиска. Трек и зал переводятся здесь же — компонент один на
          оба языка, поэтому второй перевод в страницах разошёлся бы. */}
      <div class="talk-note__related-scroll">
        <div class="talk-note__related-board">
          {relatedByDay.map((group) => (
            <section class="talk-note__board-col">
              <h3 class="talk-note__board-day">
                {group.date ? dayLongLabel(group.date, lang) : t(lang, "talksDay", { n: group.ordinal })}
              </h3>
              <ul class="talk-note__board-cards">
                {group.notes.map((note) => (
                  <li class="talk-note__board-card">
                    <a class="talk-note__board-title" href={note.hrefTalk}>{note.title}</a>
                    {note.speakers.length > 0 && (
                      <p class="talk-note__board-line">{note.speakers.join(", ")}</p>
                    )}
                    <p class="talk-note__board-line">
                      {note.track === UNTRACKED ? t(lang, "noTrack") : trackLabel(lang, note.track)} · {hallLabel(lang, note.hall)}
                    </p>
                    <p class="talk-note__board-time">{note.start}–{note.end}</p>
                  </li>
                ))}
              </ul>
            </section>
          ))}
        </div>
      </div>
    </section>
  )}
</article>

<script>
  /**
   * `talk_note_view` — одно событие на загрузку страницы заметки.
   *
   * Данные берутся из `data-*` самой статьи: их уже посчитал серверный рендер,
   * второй поиск доклада в браузере разошёлся бы с фактами страницы. Скрипт
   * живёт в компоненте, а не в двух страницах, по той же причине, что и тело:
   * RU и EN не должны разъехаться. `track` копит событие в очереди, а очередь
   * разбирается после `init` — на странице заметки `Analytics.astro` будит SDK
   * по `requestIdleCallback`, потому что иначе читатель, пришедший из поиска и
   * не тронувший ни мышь, ни скролл, не оставил бы вообще ничего.
   */
  import { classifyNoteEntry, track } from "../lib/analytics";

  const root = document.querySelector<HTMLElement>("article.talk-note[data-talk-id]");
  const talkId = Number(root?.dataset.talkId ?? "");
  const dayId = Number(root?.dataset.talkDayId ?? "");
  if (root && Number.isFinite(talkId) && Number.isFinite(dayId)) {
    // `?from=search` ставит выдача поиска; у остальных входов источник — referrer.
    const from = new URLSearchParams(window.location.search).get("from");
    track("talk_note_view", {
      talk_id: talkId,
      talk_title: root.dataset.talkTitle ?? "",
      track_id: Number(root.dataset.talkTrackId || "") || null,
      track: root.dataset.talkTrack ?? "",
      day_id: dayId,
      surface: classifyNoteEntry(document.referrer, from, window.location.origin),
      locale: root.dataset.talkLocale === "en" ? "en" : "ru",
      path: window.location.pathname,
    });
  }
</script>
