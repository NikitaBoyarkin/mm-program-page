---
/**
 * Страница графа докладов: одна проекция программы, собранная на принципах
 * Zettelkasten. Всё считается на билде — HTML остаётся читаемым без JS, а
 * клиентский чанк здесь не нужен вовсе.
 *
 * Устройство: хаб-граф (темы ↔ треки) отвечает на вопрос «где треки
 * пересекаются по смыслу», список заметок — на вопрос «что это за доклад и с
 * чем он связан», хаб темы — на вопрос «кто ещё ссылается на эту тему».
 */
import TalksGraph from "./TalksGraph.astro";
import { dayHrefFor, talkHrefFor } from "../i18n/paths";
import { t, type Lang } from "../i18n/ui";
import { portfolioHref as portfolioLink } from "../lib/analytics";
import { hallLabel, localizeTalk, trackLabel } from "../lib/localize";
import { PROGRAM, days } from "../lib/program";
import {
  buildGraph,
  buildNotes,
  layoutGraph,
  notesByTheme,
  notesByTrack,
  relatedNotes,
  themeLabel,
} from "../lib/talks-graph";
import "../styles/talks.css";
import "../styles/talks-graph.css";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;

// Номер дня берётся из порядка программы, а не из `dayId`: идентификаторы
// приходят из API и не совпадают с нумерацией маршрутов.
const dayOrdinal = new Map(days().map((day, index) => [day.id, index + 1]));

const notes = buildNotes(PROGRAM.talks, {
  dayOrdinal,
  hrefOf: (ordinal, id) => `${dayHrefFor(lang, ordinal)}#t${id}`,
  talkHrefOf: (id) => talkHrefFor(lang, id),
});
const graph = buildGraph(notes, PROGRAM.event.name);
const layout = layoutGraph(graph);
const related = relatedNotes(notes);

// Заголовки на языке страницы: темы считаются по русскому тексту (словарь
// один), но показываются переведёнными.
const titles = new Map(
  PROGRAM.talks.map((talk) => [talk.id, localizeTalk(lang, talk).title] as const),
);
const titleOf = (note: { id: number; title: string }) => titles.get(note.id) ?? note.title;

const trackGroups = notesByTrack(graph);
const themeGroups = notesByTheme(graph);
const themeEdges = graph.edges.filter((edge) => edge.kind === "topic").length;

const portfolioHref = portfolioLink(
  lang === "en" ? "/en/talks/" : "/talks/",
  "talks-footer",
);

// Имя трека для человека: «Без трека» — это хаб, а не трек, и подписи у него в
// слепке нет. Раньше сюда передавалась пустая строка, и группа (23 доклада)
// рисовалась без имени — а в ленте под-вкладок это была безымянная кнопка.
const trackName = (label: string): string =>
  label && label !== "Без трека" ? trackLabel(lang, label) : t(lang, "noTrack");

// Пикер под-раздела: кнопка-`summary` с текущим выбором и раскрывающимся
// списком ссылок. Активная ссылка и подпись на кнопке — из данных: двенадцать
// треков и одиннадцать тем иначе пришлось бы держать в двух местах. Состояние —
// по-прежнему `:target`, поэтому глубокие ссылки `#track-<n>` и `#theme-<id>`
// работают без скрипта.
const notesTargets = trackGroups.map(
  (_, index) => `.talks-view__panel--notes:has(#track-${index + 1}:target)`,
);
const themeTargets = themeGroups.map(
  (group) => `.talks-view__panel--themes:has(#theme-${group.theme.id}:target)`,
);

const pickerRules = [
  ...notesTargets.map(
    (target, index) =>
      `${target} .talks-subtab--track-${index + 1} { color: var(--text-normal); border-inline-start-color: var(--text-accent); }`,
  ),
  ...themeTargets.map(
    (target, index) =>
      `${target} .talks-subtab--theme-${themeGroups[index]?.theme.id} { color: var(--text-normal); border-inline-start-color: var(--text-accent); }`,
  ),
  ...notesTargets.map(
    (target, index) =>
      `${target} .talks-picker__current--track-${index + 1} { display: inline; }`,
  ),
  ...themeTargets.map(
    (target, index) =>
      `${target} .talks-picker__current--theme-${themeGroups[index]?.theme.id} { display: inline; }`,
  ),
].join("\n");

// Хаб трека на графе ведёт в свою группу заметок: точки на дуге на телефоне
// не цель для пальца, а кольцо — крупная мишень. Порядок групп — тот же, что у
// якорей `#track-<n>` ниже.
const trackHrefs = new Map(
  trackGroups.map((group, index) => [group.hub.key, `#track-${index + 1}`] as const),
);

---

<header class="page-head">
  <p class="eyebrow">{t(lang, "brandEvent")} · {t(lang, "talksTitle")}</p>
  <h1 class="page-title">{t(lang, "talksTitle")}</h1>
  <p class="page-intro">{t(lang, "talksIntro")}</p>
  <dl class="facts">
    <div class="facts__item">
      <dt>{t(lang, "factsTalks")}</dt>
      <dd>{notes.length}</dd>
    </div>
    <div class="facts__item">
      <dt>{t(lang, "factsTracks")}</dt>
      <dd>{trackGroups.length}</dd>
    </div>
    <div class="facts__item">
      <dt>{t(lang, "factsThemes")}</dt>
      <dd>{themeGroups.length}</dd>
    </div>
    <div class="facts__item">
      <dt>{t(lang, "factsLinks")}</dt>
      <dd>{themeEdges}</dd>
    </div>
  </dl>
</header>

<div class="talks-view">
  {/* Три проекции одной программы переключаются якорями, а не скриптом: у
      страницы нет клиентского чанка, а `:target` даёт ещё и рабочую глубокую
      ссылку — `#theme-ai` из заметки раскрывает панель тем сам. */}
  <nav class="talks-view__tabs" aria-label={t(lang, "talksViewsLabel")}>
    <a class="talks-view__tab talks-view__tab--graph" href="#talks-panel-graph">
      {t(lang, "talksTabGraph")}
    </a>
    <a class="talks-view__tab talks-view__tab--notes" href="#talks-panel-notes">
      {t(lang, "talksTabNotes")}<span class="talks-view__count">{notes.length}</span>
    </a>
    <a class="talks-view__tab talks-view__tab--themes" href="#talks-panel-themes">
      {t(lang, "talksTabThemes")}<span class="talks-view__count">{themeGroups.length}</span>
    </a>
  </nav>

  <div class="talks-view__panel talks-view__panel--graph" id="talks-panel-graph">
  <section class="talks-section" aria-labelledby="talks-graph-title">
  <h2 class="talks-section__title" id="talks-graph-title">{t(lang, "talksGraphTitle")}</h2>
  <TalksGraph layout={layout} lang={lang} titles={titles} trackHrefs={trackHrefs} />
</section>
  </div>

  <div class="talks-view__panel talks-view__panel--notes" id="talks-panel-notes">
<section class="talks-section" aria-labelledby="talks-notes-title">
  {/* `tabindex="-1"` — цель skip-link из графа: после перехода фокус стоит на
      заголовке, а не остаётся на 92-й ссылке. */}
  <h2 class="talks-section__title" id="talks-notes-title" tabindex="-1">{t(lang, "talksNotesTitle")}</h2>
  <p class="talks-section__intro">{t(lang, "talksNotesIntro")}</p>

  {/* Выбор трека — кнопка с раскрывающимся списком, а не лента вкладок:
      тринадцать имён в строку не встают, а перенос занимал пол-экрана. Тот же
      `:target` внутри списка, поэтому выбранный трек и видимая группа совпадают
      всегда, а ссылка `#track-<n>` остаётся рабочей. Подпись на кнопке —
      единственный видимый `span`, остальные гасит CSS из данных ниже. */}
  <details class="talks-picker">
    <summary class="talks-picker__button">
      <span class="talks-picker__kicker">{t(lang, "talksPickTrack")}</span>
      <span class="talks-picker__current talks-picker__current--all">{t(lang, "allTracks")}</span>
      {
        trackGroups.map((group, index) => (
          <span class:list={["talks-picker__current", `talks-picker__current--track-${index + 1}`]}>
            {trackName(group.hub.label)} · {group.notes.length}
          </span>
        ))
      }
      <span class="talks-picker__caret" aria-hidden="true">▾</span>
    </summary>
    <nav class="talks-subtabs" aria-label={t(lang, "factsTracks")}>
      <a class="talks-subtab talks-subtab--all" href="#talks-notes-title">{t(lang, "allTracks")}</a>
      {
        trackGroups.map((group, index) => (
          <a class:list={["talks-subtab", `talks-subtab--track-${index + 1}`]} href={`#track-${index + 1}`}>
            <span class="talks-subtab__label">{trackName(group.hub.label)}</span>
            <span class="talks-subtab__count">{group.notes.length}</span>
          </a>
        ))
      }
    </nav>
  </details>

  {
    trackGroups.map((group, index) => (
      <section class="track-group" id={`track-${index + 1}`} aria-labelledby={`track-${index + 1}-title`}>
        <h3 class="track-group__title" id={`track-${index + 1}-title`}>
          <span class="track-group__name">
            {trackName(group.hub.label)}
          </span>
          <span class="track-group__count">{group.notes.length}</span>
        </h3>

        <ol class="note-list">
          {group.notes.map((note) => {
            const links = (related.get(note.id) ?? []).slice(0, 4);
            const themes = note.themes.map((id) => themeLabel(id, lang));
            return (
              <li class="talk-note" id={note.anchor}>
                <p class="talk-note__meta">
                  <a class="talk-note__where" href={note.href}>
                    {t(lang, "talksDay", { n: note.dayOrdinal })} · {note.start}–{note.end} · {hallLabel(lang, note.hall)}
                  </a>
                </p>
                <p class="talk-note__title">{titleOf(note)}</p>
                <p class="talk-note__themes">
                  {
                    note.themes.length > 0 ? (
                      note.themes.map((id, themeIndex) => (
                        <>
                          {themeIndex > 0 && <span class="talk-note__sep">·</span>}
                          <a class="talk-note__theme" href={`#theme-${id}`}>{themes[themeIndex]}</a>
                        </>
                      ))
                    ) : (
                      <span class="talk-note__muted">{t(lang, "talksNoThemes")}</span>
                    )
                  }
                </p>
                {links.length > 0 && (
                  <p class="talk-note__related">
                    <span class="talk-note__related-label">{t(lang, "talksRelated")}:</span>
                    {links.map((link, linkIndex) => (
                      <>
                        {linkIndex > 0 && <span class="talk-note__sep">·</span>}
                        {/* «Связанные» — про заметку, а не про место в расписании:
                            адрес канонический (`/talk/<id>/`), а не якорь на этой
                            странице. Строка «День N · время · зал» выше — наоборот,
                            ведёт в расписание (`note.href`). */}
                        <a class="talk-note__link" href={link.hrefTalk}>{titleOf(link)}</a>
                      </>
                    ))}
                  </p>
                )}
              </li>
            );
          })}
        </ol>
      </section>
    ))
  }
</section>
  </div>

  <div class="talks-view__panel talks-view__panel--themes" id="talks-panel-themes">
<section class="talks-section" aria-labelledby="talks-themes-title">
  <h2 class="talks-section__title" id="talks-themes-title">{t(lang, "talksThemesTitle")}</h2>
  <p class="talks-section__intro">{t(lang, "talksThemesIntro")}</p>

  <details class="talks-picker">
    <summary class="talks-picker__button">
      <span class="talks-picker__kicker">{t(lang, "talksPickTheme")}</span>
      <span class="talks-picker__current talks-picker__current--all">{t(lang, "allThemes")}</span>
      {
        themeGroups.map((group) => (
          <span class:list={["talks-picker__current", `talks-picker__current--theme-${group.theme.id}`]}>
            {themeLabel(group.theme.id, lang)} · {group.notes.length}
          </span>
        ))
      }
      <span class="talks-picker__caret" aria-hidden="true">▾</span>
    </summary>
    <nav class="talks-subtabs" aria-label={t(lang, "factsThemes")}>
      <a class="talks-subtab talks-subtab--all" href="#talks-themes-title">{t(lang, "allThemes")}</a>
      {
        themeGroups.map((group) => (
          <a
            class:list={["talks-subtab", `talks-subtab--theme-${group.theme.id}`]}
            href={`#theme-${group.theme.id}`}
          >
            <span class="talks-subtab__label">{themeLabel(group.theme.id, lang)}</span>
            <span class="talks-subtab__count">{group.notes.length}</span>
          </a>
        ))
      }
    </nav>
  </details>

  <style is:global set:html={pickerRules} />

  {
    themeGroups.map((group) => (
      <section class="theme-group" id={`theme-${group.theme.id}`} aria-labelledby={`theme-${group.theme.id}-title`}>
        <h3 class="theme-group__title" id={`theme-${group.theme.id}-title`}>
          <span class="theme-group__name">{themeLabel(group.theme.id, lang)}</span>
          <span class="theme-group__count">{group.notes.length}</span>
        </h3>
        <ul class="theme-group__list">
          {group.notes.map((note) => (
            <li>
              {/* Хаб темы ссылается на заметку, а не на её якорь: у заметки один
                  канонический адрес — `/talk/<id>/`. */}
              <a class="theme-group__link" href={note.hrefTalk}>
                {titleOf(note)}
                <span class="theme-group__track">
                  {trackName(note.track)}
                </span>
              </a>
            </li>
          ))}
        </ul>
      </section>
    ))
  }
</section>
  </div>

{/* Единственный скрипт вида: выбор трека меняет хеш, но не прокручивает
    страницу. Хеш меняется навигацией, а не `replaceState`: только она
    пересчитывает `:target` (в Chromium `replaceState` оставлял подсветку и
    фильтр на прежней группе). Прокрутка возвращается сразу, до кадра, поэтому
    прыжка не видно. Без скрипта строка остаётся обычной ссылкой и ведёт к
    группе: страница читается целиком, интерактив не ломается. */}
<script is:inline>
  document.addEventListener("click", (event) => {
    const row = event.target.closest(".talks-subtab");
    if (!row) return;
    event.preventDefault();
    const top = window.scrollY;
    window.location.hash = row.getAttribute("href");
    // Chromium прокручивает к якорю не сразу, а на следующем кадре, поэтому
    // одной синхронной отмены мало — возврат повторяется в кадре.
    const restore = () => window.scrollTo(0, top);
    restore();
    requestAnimationFrame(restore);
  });
</script>
</div>

<footer class="talks-footer">
  <p class="talks-footer__note">{t(lang, "talksPortfolioNote")}</p>
  <p class="talks-footer__links">
    <a class="talks-footer__link" href={portfolioHref} rel="noopener" data-analytics="talks-footer"
      >{t(lang, "talksPortfolio")}</a
    >
    <a class="talks-footer__link" href={dayHrefFor(lang, 1)}>{t(lang, "talksToProgram")}</a>
  </p>
</footer>
