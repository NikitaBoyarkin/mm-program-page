---
/**
 * PostHog: ничего не грузится до первого взаимодействия.
 *
 * Ключ приходит из `PUBLIC_POSTHOG_KEY` на этапе сборки (локально — `.env`,
 * в CI — секрет репозитория). Без ключа компонент не рендерит скрипт вовсе,
 * поэтому сборка остаётся рабочей и без аналитики.
 *
 * Вся работа с SDK — через `src/lib/analytics.ts`: здесь только загрузка,
 * `init` и делегированный `outbound_click`. Локальные хосты не инструментируются,
 * иначе dev-сессии портят проект.
 */
const posthogKey = import.meta.env.PUBLIC_POSTHOG_KEY;
---

{posthogKey && (
  <script>
    import { attachPosthog, classifyLink, registerSuperProperties, track } from "../lib/analytics";

    const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY as string;
    const POSTHOG_HOST = import.meta.env.PUBLIC_POSTHOG_HOST || "https://us.i.posthog.com";

    const IS_LOCAL = /^(localhost|127\.0\.0\.1|::1|\[::1\]|0\.0\.0\.0)$/.test(
      window.location.hostname,
    );

    if (!IS_LOCAL && POSTHOG_KEY) {
      let started = false;

      // Клик, который запускает загрузку SDK, иначе теряется: слушатель кликов
      // появляется только после `await import()`. Копим и проигрываем после init.
      const pendingClicks: Event[] = [];
      const bufferClick = (e: Event) => {
        if (pendingClicks.length < 50) pendingClicks.push(e);
      };
      document.addEventListener("click", bufferClick, { capture: true });

      const TRIGGERS = ["pointerdown", "keydown", "scroll", "touchstart"] as const;

      async function start() {
        if (started) return;
        started = true;
        for (const type of TRIGGERS) window.removeEventListener(type, onFirstInteraction);

        let posthog: typeof import("posthog-js")["posthog"];
        try {
          ({ posthog } = await import("posthog-js"));
        } catch {
          // Чанк не загрузился (адблок, CSP) — снимаем буфер и живём дальше.
          document.removeEventListener("click", bufferClick, { capture: true });
          pendingClicks.length = 0;
          return;
        }

        posthog.init(POSTHOG_KEY, {
          api_host: POSTHOG_HOST,
          defaults: "2026-05-30",
          capture_pageview: true,
          capture_pageleave: true,
          autocapture: true,
          capture_exceptions: true,
          session_recording: { maskAllInputs: true },
        });

        attachPosthog(posthog);
        registerSuperProperties();

        const path = window.location.pathname;
        const sameHost = window.location.hostname;
        // Портфолио живёт на том же хосте, но вне base этого сайта, поэтому
        // «выход наружу» определяется по base, а не только по смене хоста.
        // Значение приходит из `base` в `astro.config.mjs` через Vite: второй
        // литерал тут — это вторая правда о деплое, которая молча отстаёт.
        // Vite отдаёт base со слэшем на конце, а `pathname` для корня — без;
        // один срез делает оба варианта равными.
        const appBase = (import.meta.env.BASE_URL || "/").replace(/\/$/, "");

        // Из query оставляем только UTM: остальное — чужие токены и сессии.
        const utmSuffix = (url: URL): string => {
          const params = new URLSearchParams();
          for (const [key, value] of url.searchParams) {
            if (key.startsWith("utm_")) params.append(key, value);
          }
          const query = params.toString();
          return query ? `?${query}` : "";
        };

        const handleClick = (e: Event) => {
          const target = e.target as Element | null;
          const anchor = target?.closest?.("a[href]") as HTMLAnchorElement | null;
          if (!anchor) return;

          let url: URL;
          try {
            url = new URL(anchor.href, window.location.href);
          } catch {
            return;
          }
          if (url.protocol !== "http:" && url.protocol !== "https:") return;
          // Сравнение с base как с префиксом пути, а не строкой: посторонний
          // путь с тем же началом не должен считаться «внутри приложения».
          // Корневой деплой (`base: "/"`) вырождает base в пустую строку, и тогда
        // «внутри приложения» — это весь хост. Сравнение по хосту остаётся
        // единственным различителем: иначе переход в портфолио на том же
        // домене молча считался бы внутренним.
        const leavesApp = appBase
          ? !(url.pathname === appBase || url.pathname.startsWith(`${appBase}/`))
          : url.hostname !== sameHost;
          if (url.hostname === sameHost && !leavesApp) return;

          const linkTarget = classifyLink({
            className: anchor.className,
            hostname: url.hostname,
            pathname: url.pathname,
            utmContent: url.searchParams.get("utm_content"),
            utmMedium: url.searchParams.get("utm_medium"),
            ctaTarget: anchor.dataset.ctaTarget ?? null,
          });
          const holder = anchor.closest("[data-talk-id]");
          const talkId = holder?.getAttribute("data-talk-id") ?? null;

          track("outbound_click", {
            domain: url.hostname,
            // Только путь: полный href утащил бы в аналитику чужие query-токены,
            // а UTM-метки переездов внутри портфолио нужны — их оставляем.
            url: url.origin + url.pathname + utmSuffix(url),
            surface: anchor.dataset.analytics || "content",
            path,
            link: linkTarget.link,
            kind: linkTarget.kind,
            network: linkTarget.network,
            // Доклад и спикер — чтобы «топ ссылок» читался рядом с «топом докладов».
            talk_id: talkId ? Number(talkId) : null,
            speaker: anchor.dataset.speaker || null,
            label: (anchor.getAttribute("aria-label") || "").slice(0, 80) || null,
          });
        };

        document.addEventListener("click", handleClick);
        document.removeEventListener("click", bufferClick, { capture: true });
        for (const event of pendingClicks.splice(0)) handleClick(event);
      }

      function onFirstInteraction() {
        void start();
      }

      for (const type of TRIGGERS) {
        window.addEventListener(type, onFirstInteraction, { passive: true });
      }

      // Страница заметки доклада — единственное место, где пассивный читатель
      // и есть целевая аудитория: пришёл из поиска, прочитал, ушёл, ничего не
      // тронув. `talk_note_view` уже лежит в очереди, но очередь разбирается
      // только после `init` — без этой ветки событие не уходило бы никогда.
      // Узкое исключение, а не общий `requestIdleCallback`: остальные страницы
      // по-прежнему не грузят 115 КБ тому, кто просто открыл вкладку.
      if (document.querySelector("[data-talk-note]")) {
        const wake = () => void start();
        if ("requestIdleCallback" in window) {
          window.requestIdleCallback(wake, { timeout: 3000 });
        } else {
          setTimeout(wake, 1500);
        }
      }
      // Пассивного посетителя не инструментируем вовсе: контракт обещает
      // «SDK грузится только после первого взаимодействия», а `scroll` уже
      // входит в TRIGGERS — читатель, который листает страницу, даёт `$pageview`.
      // Отложенный `requestIdleCallback` нарушал это обещание и тянул 115 КБ
      // gzip каждому, кто просто открыл вкладку.
    }
  </script>
)}
