---
/**
 * Оболочка модалки доклада. Контейнеры пустые: содержимое подставляет
 * `src/scripts/program-client.ts` из `/program.json` — разметка на билде,
 * данные по запросу. Пока модалка закрыта, она `hidden` и не в a11y-дереве.
 */
import { t, type Lang } from "../i18n/ui";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
---

<div class="talk-modal" data-modal hidden>
  <div class="talk-modal__backdrop" data-modal-backdrop></div>
  <div
    class="talk-modal__dialog"
    role="dialog"
    aria-modal="true"
    aria-labelledby="talk-modal-title"
    data-modal-dialog
    tabindex="-1"
  >
    <button class="talk-modal__close" type="button" data-modal-close aria-label={t(lang, "modalClose")}>
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>

    <div class="talk-modal__media" data-modal-media></div>

    <div class="talk-modal__body">
      <div class="talk-modal__meta" data-modal-meta></div>
      <h2 class="talk-modal__title" id="talk-modal-title" data-modal-title></h2>
      <div class="talk-modal__speakers" data-modal-speakers></div>
      <div class="talk-modal__text" data-modal-text></div>
      <div class="talk-modal__actions">
        <a
          class="talk-modal__buy"
          href="https://matemarketing.ru/tickets/"
          target="_blank"
          rel="noopener"
        >
          {t(lang, "modalBuy")}
        </a>
        <button class="talk-modal__fav" type="button" data-modal-fav aria-pressed="false">
          <span data-modal-fav-label>{t(lang, "modalFavAdd")}</span>
        </button>
      </div>
    </div>
  </div>
</div>

<script is:inline>
  // Пока диалог открыт, всё остальное — `inert`. Фокус-трап в `program-client.ts`
  // держит Tab внутри диалога, но не мешает клику мышью или программному
  // `focus()`; `inert` убирает остальной документ из таб-порядка и дерева
  // доступности. Сам `.talk-modal` остаётся вне инертных поддеревьев — он ребёнок
  // `main`, поэтому инертим `main.children` поштучно, а не `main` целиком.
  //
  // Закрытие снимает `inert` синхронно в capture-фазе: `closeModal()` возвращает
  // фокус на кнопку-открывашку сразу после снятия класса, а MutationObserver
  // успел бы только после — и `focus()` провалился бы в инертном поддереве.
  (function () {
    var modal = document.querySelector("div[data-modal]");
    if (!modal) return;

    // Что мы включили и в каком состоянии это было: `inert` у закрытого drawer'а
    // уже стоит и снимать его на закрытии модалки нельзя.
    var applied = [];

    var release = function () {
      while (applied.length) {
        var item = applied.pop();
        if (!item.inert) item.el.removeAttribute("inert");
        if (item.ariaHidden === null) item.el.removeAttribute("aria-hidden");
        else item.el.setAttribute("aria-hidden", item.ariaHidden);
      }
    };

    var apply = function () {
      if (applied.length) return;
      var targets = [];
      var outside = document.querySelectorAll(
        "body > a.skip-link, body > header, body > nav, body > footer, body > .nav-scrim",
      );
      for (var i = 0; i < outside.length; i += 1) targets.push(outside[i]);
      var main = document.getElementById("main");
      if (main) {
        for (var j = 0; j < main.children.length; j += 1) {
          if (!main.children[j].contains(modal)) targets.push(main.children[j]);
        }
      }
      for (var k = 0; k < targets.length; k += 1) {
        var el = targets[k];
        applied.push({
          el: el,
          inert: el.hasAttribute("inert"),
          ariaHidden: el.getAttribute("aria-hidden"),
        });
        el.setAttribute("inert", "");
        // Фолбэк для движков без `inert`: скринридер не должен читать фон.
        el.setAttribute("aria-hidden", "true");
      }
    };

    document.addEventListener(
      "keydown",
      function (event) {
        if (event.key === "Escape" && !modal.hidden) release();
      },
      true,
    );

    document.addEventListener(
      "click",
      function (event) {
        var target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest("[data-modal-close], [data-modal-backdrop]")) release();
      },
      true,
    );

    new MutationObserver(function () {
      if (document.body.classList.contains("is-modal-open")) apply();
      else release();
    }).observe(document.body, { attributes: true, attributeFilter: ["class"] });
  })();
</script>

<style>
  /* Спикеров в модалку вставляет `program-client.ts` уже после загрузки
     `/program.json`, поэтому узлы не получают scope-атрибут Astro — правила
     идут через `:global`. `program.css` эти классы пока не описывает; набор
     ниже — минимальный фолбэк (круглое фото 36px, как в карточке). */
  :global(.talk-modal__speaker) {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    min-inline-size: 0;
  }

  :global(.talk-modal__speaker-photo),
  :global(.talk-modal__speaker-avatar-fallback) {
    display: inline-flex;
    flex: none;
    align-items: center;
    justify-content: center;
    inline-size: 36px;
    block-size: 36px;
    border: 1px solid var(--border-color);
    border-radius: var(--radius-full);
    background: var(--surface-secondary);
    color: var(--text-normal);
    font-size: 0.8rem;
    font-weight: 600;
    object-fit: cover;
  }

  :global(.talk-modal__speaker-info) {
    display: flex;
    flex-direction: column;
    min-inline-size: 0;
  }

  :global(.talk-modal__speaker-name) {
    color: var(--text-normal);
    font-size: 0.9rem;
    font-weight: 600;
    line-height: 1.35;
  }

  :global(.talk-modal__speaker-desc) {
    color: var(--text-muted);
    font-size: 0.8rem;
    line-height: 1.4;
  }
</style>
