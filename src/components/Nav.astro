---
/**
 * Шапка и off-canvas меню. Живёт в layout'е, а не в странице программы:
 * навигация одинаково нужна сетке, дням и 404.
 */
import { dayLabel } from "../i18n/format";
import { dayHrefFor, switchLangHref } from "../i18n/paths";
import { otherLang, t, type Lang } from "../i18n/ui";
import { dayNameLabel } from "../lib/localize";
import { days } from "../lib/program";

interface Props {
  /** 1-based номер текущего дня — подсвечивает соответствующую строку. */
  ordinal?: number;
  lang: Lang;
  /** Кнопка поиска: только там, где есть клиентский скрипт (страницы дня). */
  search?: boolean;
}

const { ordinal, lang, search = false } = Astro.props;
const portfolio = "https://nikitaboyarkin.github.io";

const dayLinks = days().map((day, index) => ({
  ordinal: index + 1,
  href: dayHrefFor(lang, index + 1),
  label: `${dayNameLabel(lang, day.name)} ${dayLabel(day.date, lang)}`.trim(),
}));

const siteLinks = [
  { href: `${portfolio}/`, label: t(lang, "navHome") },
  { href: `${portfolio}/projects/`, label: t(lang, "navProjects") },
  { href: `${portfolio}/contact/`, label: t(lang, "navContacts") },
];

// Переключатель уводит на тот же день другой локали: подпись — код цели.
const targetLang = otherLang(lang);
const langHref = switchLangHref(lang, ordinal ?? 1);
const langCode = targetLang.toUpperCase();
---

<header class="nav-mobile">
  <a class="nav-brand" href={`${portfolio}/`}>
    <svg
      class="nav-brand-icon"
      viewBox="0 0 24 24"
      width="18"
      height="18"
      fill="none"
      stroke="currentColor"
      stroke-width="2"
      stroke-linecap="round"
      aria-hidden="true"
      focusable="false"
    >
      <path d="M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9"></path>
    </svg>
    <span class="nav-brand-text">
      <b>{t(lang, "brandName")}</b>
      <span class="nav-brand-role">{t(lang, "brandRole")}</span>
    </span>
  </a>

  <ul class="nav-inline">
    {
      siteLinks.map((link) => (
        <li>
          <a href={link.href} rel="noopener">{link.label}</a>
        </li>
      ))
    }
  </ul>

  <div class="nav-top-actions">
    {
      search && (
        <button
          class="nav-icon-btn"
          type="button"
          data-search-open
          aria-label={t(lang, "searchOpen")}
          aria-controls="search-dialog"
          aria-expanded="false"
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-4.3-4.3"></path>
          </svg>
        </button>
      )
    }

    <a
      class="nav-icon-btn nav-lang"
      href={langHref}
      hreflang={targetLang}
      lang={targetLang}
      aria-label={t(lang, "langSwitch")}
      title={t(lang, "langSwitch")}>{langCode}</a
    >

    <button
      class="nav-icon-btn theme-toggle--header"
      type="button"
      data-theme-toggle
      aria-label={t(lang, "navThemeToggle")}
      title={t(lang, "navThemeHint")}
    >
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
    </button>

    <button
      class="nav-toggle"
      type="button"
      data-nav-open
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t(lang, "navOpen")}
      data-label-open={t(lang, "navOpen")}
      data-label-close={t(lang, "navClose")}
    >
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>
  </div>
</header>

<div class="nav-scrim" data-nav-close></div>

<nav id="site-nav" aria-label={t(lang, "navMenuLabel")}>
  <div class="drawer-head">
    <a class="nav-brand" href={`${portfolio}/`}>
      <svg
        class="nav-brand-icon"
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M12 3v18M4.2 7.5l15.6 9M19.8 7.5l-15.6 9"></path>
      </svg>
      <span class="nav-brand-text">
        <b>Никита Бояркин</b>
        <span class="nav-brand-role">Продуктовый аналитик</span>
      </span>
    </a>
    <button class="drawer-close" type="button" data-nav-close aria-label={t(lang, "navClose")}>
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <ul class="drawer-links">
    {
      dayLinks.map((link) => (
        <li>
          <a
            class:list={["drawer-link", link.ordinal === ordinal ? "is-current" : null]}
            href={link.href}
            aria-current={link.ordinal === ordinal ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
    {
      siteLinks.map((link) => (
        <li>
          <a class="drawer-link" href={link.href} rel="noopener">{link.label}</a>
        </li>
      ))
    }
  </ul>

  <div class="drawer-foot">
    <p class="drawer-favs">
      <span>{t(lang, "navFavorites")}</span>
      <span class="drawer-favs__count" data-favorites-count>0</span>
    </p>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={t(lang, "navThemeToggle")}>
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M21 12.79A9 9 0 1 1 11.21 3 7 7 0 0 0 21 12.79z"></path>
      </svg>
      <span>{t(lang, "navThemeToggle")}</span>
    </button>
    <p>{t(lang, "navThemeNote")}</p>
    <a
      class="nav-icon-btn nav-lang"
      href={langHref}
      hreflang={targetLang}
      lang={targetLang}
      aria-label={t(lang, "langSwitch")}
      title={t(lang, "langSwitch")}>{langCode}</a
    >
  </div>
</nav>

<style>
  /* Кнопки справа в шапке: тема + меню. Группа забирает `margin-inline-start:
     auto` у тумблера, иначе два auto-отступа делят свободное место и кнопки
     разъезжаются от края. */
  .nav-top-actions {
    display: flex;
    flex: none;
    align-items: center;
    gap: var(--space-2);
    margin-inline-start: auto;
  }

  .nav-top-actions > .nav-toggle {
    margin-inline-start: 0;
  }

  /* Тема доступна из шапки, не открывая drawer: на странице программы тема —
     частая операция, а меню на мобиле ещё и перекрывает контент.
     Стиль повторяет `.nav-toggle`, но отдельным классом: `.nav-toggle` в
     `site.css` занят меню и гасится на печати. */
  .nav-icon-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    inline-size: 44px;
    block-size: 44px;
    padding: 0;
    /* Литералы, а не `--button-*`: в киберпанке те токены красят кнопку в
       розовый. Пара #171717 / #f8f2da — контраст 15.7:1 в любой теме. */
    border: 1px solid color-mix(in srgb, #f8f2da 22%, transparent);
    border-radius: var(--radius-full);
    background: #171717;
    color: #f8f2da;
    line-height: 1;
    cursor: pointer;
    transition:
      transform 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  @media (hover: hover) and (pointer: fine) {
    .nav-icon-btn:hover {
      border-color: var(--border-active);
      background: #2e2e2e;
      color: #f8f2da;
    }
  }

  .nav-icon-btn:active {
    transform: scale(0.95);
  }

  .nav-icon-btn:focus-visible {
    outline: 2px solid var(--text-accent);
    outline-offset: 2px;
  }

  @media (prefers-reduced-motion: reduce) {
    .nav-icon-btn {
      transition: none;
    }

    .nav-icon-btn:active {
      transform: none;
    }
  }

  @media print {
    .nav-top-actions {
      display: none;
    }
  }

  /* Переключатель языка — текст, а не иконка: «EN»/«RU» читается сразу и не
     требует новой иконки. Геометрия 44×44 наследуется от `.nav-icon-btn`. */
  .nav-lang {
    font-size: 0.85rem;
    text-decoration: none;
    text-transform: uppercase;
    letter-spacing: 0.04em;
  }
</style>
