---
/**
 * Шапка и off-canvas меню. Живёт в layout'е, а не в странице программы:
 * навигация одинаково нужна сетке, дням и 404.
 */
import { dayLabel } from "../i18n/format";
import { dayHrefFor, switchLangHref, talksHrefFor } from "../i18n/paths";
import { otherLang, t, type Lang } from "../i18n/ui";
import { STAR, TAG } from "../lib/icons";
import { dayNameLabel, trackLabel } from "../lib/localize";
import { days, tracksOfProgram } from "../lib/program";
import { THEME_PATHS } from "../lib/theme";

interface Props {
  /** 1-based номер текущего дня — подсвечивает соответствующую строку. */
  ordinal?: number;
  lang: Lang;
  /** Кнопка поиска: только там, где есть клиентский скрипт (страницы дня). */
  search?: boolean;
  /** Строка «Избранное»: тот же фильтр, что у чипа, значит нужен тот же скрипт. */
  favorites?: boolean;
  /** Кнопка «Все треки»: сбрасывает фильтр трека, значит нужен тот же скрипт. */
  tracks?: boolean;
  /** Какая это страница: у графа свой адрес и свой пункт «текущая страница». */
  page?: "day" | "talks";
}

const { ordinal, lang, search = false, favorites = false, tracks = false, page = "day" } = Astro.props;
const portfolio = "https://nikitaboyarkin.github.io";

// Переход на портфолио размечен: без UTM визит, начавшийся в новой сессии,
// выглядит прямым заходом, и связка двух сайтов в отчёте теряется.
const portfolioHref = (path: string, content: string) =>
  `${portfolio}${path}?utm_source=mm-program-page&utm_medium=referral` +
  `&utm_campaign=mm_program_to_portfolio&utm_content=${content}`;

const dayLinks = days().map((day, index) => ({
  ordinal: index + 1,
  href: dayHrefFor(lang, index + 1),
  label: `${dayNameLabel(lang, day.name)} ${dayLabel(day.date, lang)}`.trim(),
}));

const siteLinks = [
  { href: portfolioHref("/", "nav-home"), label: t(lang, "navHome"), icon: "home" },
  { href: portfolioHref("/projects/", "nav-projects"), label: t(lang, "navProjects"), icon: "projects" },
  { href: portfolioHref("/contact/", "nav-contacts"), label: t(lang, "navContacts"), icon: "contacts" },
];

// «Граф докладов» — своя страница этого сайта, а не ссылка портфолио: та же
// программа, вторая проекция (треки, темы, связи). Живёт в трёх местах по
// ширине: текстовый пункт в инлайновой полосе (≥ 1024 px), иконка в группе
// действий (480–1023.98 px) и пункт в панели меню (всегда). Одна запись не
// может стоять сразу в двух местах полосы — поэтому правила медиаскрытия.
const talksHref = talksHrefFor(lang);

// Переключатель уводит на тот же день другой локали: подпись — код цели.
// Пункты меню «Все треки»: сброс + те же 11 треков, что у чипов под вкладками
// дня. Считаются на билде, как и сами чипы, поэтому список один.
const trackOptions = tracksOfProgram().map((name) => ({ name, label: trackLabel(lang, name) }));

const targetLang = otherLang(lang);
// С страницы графа язык переключается на граф, а не на первый день: иначе
// переключатель уводил бы читателя с той страницы, которую он читает.
const langHref = page === "talks" ? talksHrefFor(targetLang) : switchLangHref(lang, ordinal ?? 1);
const langCode = targetLang.toUpperCase();
---

<header class="nav-mobile">
  <a class="nav-brand" href={portfolioHref("/", "brand-mobile")} aria-label={t(lang, "brandName")}>
    <span class="nav-brand-icon" aria-hidden="true"></span>
    <span class="nav-brand-text">
      <b>{t(lang, "brandName")}</b>
      <span class="nav-brand-role">{t(lang, "brandRole")}</span>
    </span>
  </a>

  <ul class="nav-inline">
    {/* Свой пункт сайта идёт первым: он про эту программу, а три ссылки ниже —
        про сайт-портфолио. Инлайновая полоса видна только ≥ 1024 px; ниже
        «Граф докладов» даёт иконка в группе действий. */}
    <li>
      <a
        class="nav-link--talks"
        href={talksHref}
        aria-current={page === "talks" ? "page" : undefined}
      >
        {t(lang, "navTalks")}
      </a>
    </li>
    {
      siteLinks.map((link) => (
        <li>
          <a class={`nav-link--${link.icon}`} href={link.href} rel="noopener">{link.label}</a>
        </li>
      ))
    }
  </ul>

  <div class="nav-top-actions">
    {/* «Избранное» в шапке — первым в группе: это фильтр по контенту, а поиск,
        язык и тема обслуживают страницу. Тот же переключатель, что у чипа под
        вкладками дня, но всегда на виду: чип уезжает вверх вместе с тулбаром.
        Счётчик несёт `data-favorites-count` — тот же атрибут, что у кнопки в
        панели, поэтому обновляет их одна функция. */}
    {favorites && (
      <button
        class="nav-icon-btn nav-fav"
        type="button"
        data-fav-header
        aria-pressed="false"
        title={t(lang, "navFavoritesOpen")}
      >
        <svg
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.6"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d={STAR}></path>
        </svg>
        {/* Подпись скрыта, но из неё и счётчика складывается имя кнопки:
            «Избранное 3» — число в имени, а не только на экране. */}
        <span class="visually-hidden">{t(lang, "navFavorites")}</span>
        <span class="nav-fav__count" data-favorites-count>0</span>
      </button>
    )}

    {/* «Все треки» — раскрывающийся список, а не сброс. Первая версия кнопки
        снимала фильтр, и при полном списке клик не делал ничего: со стороны это
        «кнопка не работает». Здесь кнопка открывает те же 12 пунктов, что и
        чипы под вкладками дня (сброс + 11 треков), поэтому выбор трека из шапки
        — один тап, а не прогулка к тулбару. */}
    {tracks && (
      <div class="nav-tracks">
        <button
          class="nav-icon-btn nav-tracks__trigger"
          type="button"
          data-track-header
          aria-expanded="false"
          aria-controls="track-menu"
          aria-haspopup="true"
          title={t(lang, "allTracks")}
        >
          <svg
            viewBox="0 0 24 24"
            width="18"
            height="18"
            fill="none"
            stroke="currentColor"
            stroke-width="1.8"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
            focusable="false"
          >
            <path d={TAG}></path>
          </svg>
          <span class="visually-hidden">{t(lang, "allTracks")}</span>
        </button>

        <div
          class="track-menu"
          id="track-menu"
          role="group"
          aria-label={t(lang, "trackFiltersLabel")}
          data-track-menu
          hidden
        >
          {/* Сброс первым и с тем же `aria-pressed`, что у чипов: состояние у
              группы одно, и «Все треки» — его член, а не отдельная команда. */}
          <button class="track-menu__item" type="button" data-track-option data-track="" aria-pressed="true">
            {t(lang, "allTracks")}
          </button>
          {trackOptions.map((option) => (
            <button
              class="track-menu__item"
              type="button"
              data-track-option
              data-track={option.name}
              aria-pressed="false"
            >
              {option.label}
            </button>
          ))}
        </div>
      </div>
    )}

    {/* 480–1023.98 px: текстовой полосы нет (она уходит в drawer), но место под
        шестую иконку есть. Ниже 480 px кнопка скрыта: пять целей по 44 px уже
        занимают 285 px из 296 возможных, шестая не влезает физически — там
        граф доступен из панели меню. Выше 1024 px пункт живёт текстом в
        `.nav-inline`, поэтому иконка скрыта, чтобы не дублировать вход. */}
    <a
      class="nav-icon-btn nav-graph"
      href={talksHref}
      aria-label={t(lang, "navTalks")}
      title={t(lang, "navTalks")}
      aria-current={page === "talks" ? "page" : undefined}
    >
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="1.8"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="18" cy="5" r="3"></circle>
        <circle cx="6" cy="12" r="3"></circle>
        <circle cx="18" cy="19" r="3"></circle>
        <path d="M8.59 13.51l6.83 3.98M15.41 6.51L8.59 10.49"></path>
      </svg>
    </a>

    {
      search && (
        <button
          class="nav-icon-btn"
          type="button"
          data-search-open
          aria-label={t(lang, "searchOpen")}
          aria-controls="search-dialog"
          aria-expanded="false"
        >
          <svg
            viewBox="0 0 24 24"
            width="20"
            height="20"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            aria-hidden="true"
            focusable="false"
          >
            <circle cx="11" cy="11" r="7"></circle>
            <path d="M20 20l-4.3-4.3"></path>
          </svg>
        </button>
      )
    }

    <a
      class="nav-icon-btn nav-lang"
      href={langHref}
      hreflang={targetLang}
      lang={targetLang}
      aria-label={t(lang, "langSwitch")}
      title={t(lang, "langSwitch")}
    >
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20"></path>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
        ></path>
      </svg>
      <span>{langCode}</span>
    </a>

    <button
      class="nav-icon-btn theme-toggle--header"
      type="button"
      data-theme-toggle
      aria-label={t(lang, "navThemeToggle")}
      title={t(lang, "navThemeHint")}
      data-theme-icons={JSON.stringify(THEME_PATHS)}
    >
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d={THEME_PATHS.dark}></path>
      </svg>
    </button>

    <button
      class="nav-toggle"
      type="button"
      data-nav-open
      aria-expanded="false"
      aria-controls="site-nav"
      aria-label={t(lang, "navOpen")}
      data-label-open={t(lang, "navOpen")}
      data-label-close={t(lang, "navClose")}
    >
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M3 6h18M3 12h18M3 18h18"></path>
      </svg>
    </button>
  </div>
</header>

<div class="nav-scrim" data-nav-close></div>

<nav id="site-nav" aria-label={t(lang, "navMenuLabel")}>
  <div class="drawer-head">
    <a class="nav-brand" href={portfolioHref("/", "brand-drawer")}>
      <span class="nav-brand-icon" aria-hidden="true"></span>
      <span class="nav-brand-text">
        <b>{t(lang, "brandName")}</b>
        <span class="nav-brand-role">{t(lang, "brandRole")}</span>
      </span>
    </a>
    <button class="drawer-close" type="button" data-nav-close aria-label={t(lang, "navClose")}>
      <svg
        viewBox="0 0 24 24"
        width="20"
        height="20"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d="M6 6l12 12M18 6L6 18"></path>
      </svg>
    </button>
  </div>

  <ul class="drawer-links">
    {
      dayLinks.map((link) => (
        <li>
          <a
            class:list={["drawer-link", "drawer-link--day", link.ordinal === ordinal ? "is-current" : null]}
            href={link.href}
            aria-current={link.ordinal === ordinal ? "page" : undefined}
          >
            {link.label}
          </a>
        </li>
      ))
    }
    <li>
      <a
        class="drawer-link drawer-link--talks"
        href={talksHref}
        aria-current={page === "talks" ? "page" : undefined}
      >
        {t(lang, "navTalks")}
      </a>
    </li>
    {
      siteLinks.map((link) => (
        <li>
          <a class={`drawer-link drawer-link--${link.icon}`} href={link.href} rel="noopener">{link.label}</a>
        </li>
      ))
    }
  </ul>

  <div class="drawer-foot">
    {/* Не подпись, а кнопка: из панели избранное открывается одним тапом.
        Счётчик остаётся тем же `data-favorites-count`, его обновляет клиент. */}
    {favorites && (
    <button
      class="drawer-favs"
      type="button"
      data-fav-drawer
      aria-pressed="false"
      aria-label={t(lang, "navFavoritesOpen")}
      title={t(lang, "navFavoritesOpen")}
    >
      <span>{t(lang, "navFavorites")}</span>
      <span class="drawer-favs__tail">
        <span class="drawer-favs__count" data-favorites-count>0</span>
        <svg
          class="drawer-favs__arrow"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          aria-hidden="true"
          focusable="false"
        >
          <path d="M9 6l6 6-6 6"></path>
        </svg>
      </span>
    </button>
    )}
    <button class="theme-toggle" type="button" data-theme-toggle aria-label={t(lang, "navThemeToggle")}>
      <svg
        viewBox="0 0 24 24"
        width="18"
        height="18"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <path d={THEME_PATHS.dark}></path>
      </svg>
      <span>{t(lang, "navThemeToggle")}</span>
    </button>
    <a
      class="nav-icon-btn nav-lang"
      href={langHref}
      hreflang={targetLang}
      lang={targetLang}
      aria-label={t(lang, "langSwitch")}
      title={t(lang, "langSwitch")}
    >
      <svg
        viewBox="0 0 24 24"
        width="16"
        height="16"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        aria-hidden="true"
        focusable="false"
      >
        <circle cx="12" cy="12" r="10"></circle>
        <path d="M2 12h20"></path>
        <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"
        ></path>
      </svg>
      <span>{langCode}</span>
    </a>
  </div>
</nav>

