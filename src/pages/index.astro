---
import Base from "../layouts/Base.astro";
import ProgramPage from "../components/ProgramPage.astro";
import { t } from "../i18n/ui";
import { bannerSources } from "../lib/images";
import { dayByOrdinal, firstBanner } from "../lib/program";
import { dayLongLabel } from "../i18n/format";

const lang = "ru" as const;
const day = dayByOrdinal(1);
const banner = firstBanner(day);
const title = `${t(lang, "pageTitle")} ${t(lang, "brandEvent")} — ${dayLongLabel(day.date, lang)}`;
const description = t(lang, "metaDescription");
---

<Base
  title={title}
  description={description}
  lang={lang}
  dayId={day.id}
  dayDate={day.date}
  dayOrdinal={1}
  preloadBanner={bannerSources(banner?.url ?? null)}
>
  <ProgramPage day={day} ordinal={1} lang={lang} />
</Base>
