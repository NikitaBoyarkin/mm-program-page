---
/**
 * Каркас страницы: `<head>`, тема до первой отрисовки, шапка с drawer'ом,
 * `main` и подвал. Модалку и клиентский скрипт подключает страница программы,
 * а не этот layout: `404` не должна тянуть 90 КБ данных.
 */
import Analytics from "../components/Analytics.astro";
import CollabCta from "../components/CollabCta.astro";
import Nav from "../components/Nav.astro";
import { dayHrefFor } from "../i18n/paths";
import { t, type Lang } from "../i18n/ui";
import { BASE_URL } from "../lib/program";
import type { BannerSources } from "../lib/images";
import "../styles/tokens.css";
import "../styles/site.css";
// Стили шапки и её меню — после каркаса: `.nav-icon-btn` обязан перекрывать
// кнопочные правила site.css, как это делал scoped-блок компонента.
import "../styles/nav.css";

// Шрифты живут в `src/assets/fonts` и проходят через бандлер (DECISIONS §8):
// `?url` отдаёт тот же хешированный путь, что и `url()` в `tokens.css`, поэтому
// `preload` реально прогревает файл, а не второй экземпляр рядом.
import interCyrillicUrl from "../assets/fonts/inter-cyrillic.woff2?url";
import interLatinUrl from "../assets/fonts/inter-latin.woff2?url";
import cormorantCyrillicUrl from "../assets/fonts/cormorant-cyrillic.woff2?url";
// Баннер превью ссылки. `?url` отдаёт путь с `base` и контент-хэшем в имени,
// поэтому новая картинка = новый URL: Telegram и LinkedIn переспрашивают её
// только при смене адреса, своего cache-bust у них нет.
import ogBannerUrl from "../assets/og/program-2026.png?url";

interface Props {
  title: string;
  description?: string;
  /** Язык страницы: `lang` у `<html>`, словарь подвала, `og:locale`. */
  lang?: Lang;
  /** День программы — уходит на `<html>`, чтобы клиент не искал его заново. */
  dayId?: number | string;
  /** Дата дня, `YYYY-MM-DD`. */
  dayDate?: string;
  /** 1-based номер дня: подсвечивает строку в drawer'е. */
  dayOrdinal?: number;
  /** Баннер первой карточки: `<link rel=preload>` только для десктопной сетки.
   *  Это `bannerSources(...)` — тот же объект, что уходит в `<img srcset>` карточки:
   *  предзагрузка обязана просить ровно тот вариант, который выберет `srcset`,
   *  иначе браузер качает два файла. */
  preloadBanner?: BannerSources | null;
  /** Какая это поверхность: у графа и заметки доклада свой адрес и свой пункт в шапке. */
  page?: "day" | "talks" | "talk";
  /** Путь пары в другом языке (`en/talks/`) для страниц, у которых нет дня:
   *  у дней пара считается из `dayOrdinal`, у графа — только отсюда. */
  alternatePath?: string;
}

const {
  title,
  lang = "ru",
  description = t(lang, "metaDescription"),
  dayId,
  dayDate,
  dayOrdinal,
  preloadBanner = null,
  page = "day",
  alternatePath,
} = Astro.props;

// Канонический адрес — только путь: `?track=` и прочие UTM-хвосты не должны
// плодить дубли в индексе. `Astro.url.pathname` уже содержит `base`, а `site`
// из `astro.config.mjs` даёт абсолютный origin.
const canonical = new URL(Astro.url.pathname, Astro.site ?? Astro.url);
canonical.search = "";
canonical.hash = "";
const canonicalHref = canonical.href;

// Картинка превью — абсолютный адрес: `og:image` не разрешает относительные,
// а страница живёт под `base` project-страницы GitHub Pages.
const ogImageHref = new URL(ogBannerUrl, Astro.site ?? Astro.url).href;
// Alt баннера — на языке страницы: одна и та же картинка живёт и на /en/, а
// подпись читает скринридер и соцсеть-превью.
const ogImageAlt =
  lang === "ru"
    ? "Программа конференции Матемаркетинг 2026 — расписание докладов"
    : "Matemarketing 2026 conference program — talk schedule";

// `hreflang` у страниц дня считается из номера дня; у графа дня нет, поэтому
// пара приходит путём (`alternatePath`). `x-default` указывает на русскую
// версию — она первична.
const origin = Astro.site ?? Astro.url;
const alternates =
  dayOrdinal != null
    ? (["ru", "en"] as const).map((code) => ({
        hreflang: code,
        href: new URL(dayHrefFor(code, dayOrdinal), origin).href,
      }))
    : alternatePath
      ? [
          { hreflang: lang, href: canonicalHref },
          { hreflang: lang === "ru" ? "en" : "ru", href: new URL(`${BASE_URL}${alternatePath}`, origin).href },
        ]
      : [];
const defaultAlternate = alternates.find((alternate) => alternate.hreflang === "ru");

// Подвал собирается из шаблона с маркером `{link}`: перевод остаётся строкой,
// а `<a>` встаёт в позицию маркера — так ссылка не растворяется в переводе.
const [sourceBefore, sourceAfter = ""] = t(lang, "footerSource").split("{link}");
const [ticketsBefore, ticketsAfter = ""] = t(lang, "footerTickets").split("{link}");
---

<!doctype html>
<html lang={lang} data-lang={lang} data-theme="dark" data-day-id={dayId} data-day-date={dayDate}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1, viewport-fit=cover, interactive-widget=resizes-content"
    />
    <meta
      name="format-detection"
      content="telephone=no,date=no,address=no,email=no"
    />
    <title>{title}</title>
    <meta name="description" content={description} />

    <!-- Медиа — hotlink с CDN первоисточника. Три `preconnect` без `crossorigin`:
         соединение общее для обычных GET картинок, а CORS-режим только добавил
         бы второй сокет. -->
    <link rel="preconnect" href="https://storage.yandexcloud.net" />
    <link rel="preconnect" href="https://img.matemarketing.ru" />
    <link rel="preconnect" href="https://mm-graphics.netlify.app" />

    <!-- Первый экран: кириллица Inter (текст), латиница Inter (числа, латинские
         имена) и кириллица Cormorant (заголовок). Остальные сабсеты грузятся
         по требованию. `crossorigin` обязателен: шрифты запрашиваются в
         CORS-режиме даже с того же origin, и без него браузер не переиспользует
         предзагрузку. -->
    <link
      rel="preload"
      href={interCyrillicUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={interLatinUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />
    <link
      rel="preload"
      href={cormorantCyrillicUrl}
      as="font"
      type="font/woff2"
      crossorigin="anonymous"
    />

    {/* LCP на десктопе — первый баннер. `lazy`-картинка стартует слишком поздно,
        а `eager` на телефоне качал бы её впустую: баннеры там `display: none`.
        Поэтому предзагрузка с медиа-условием, а приоритет отдаёт `fetchpriority`. */}
    {preloadBanner && (
      <link
        rel="preload"
        as="image"
        href={preloadBanner.src}
        imagesrcset={preloadBanner.srcset}
        imagesizes={preloadBanner.sizes}
        media="(min-width: 768px)"
        fetchpriority="high"
      />
    )}

    <link rel="icon" type="image/svg+xml" href={`${BASE_URL}favicon.svg`} />
    <link rel="apple-touch-icon" sizes="180x180" href={`${BASE_URL}apple-touch-icon.png`} />
    <link rel="manifest" href={`${BASE_URL}manifest.webmanifest`} />
    <meta id="theme-color" name="theme-color" content="#1400c3" />

    <link rel="canonical" href={canonicalHref} />
    {
      alternates.map((alternate) => (
        <link rel="alternate" hreflang={alternate.hreflang} href={alternate.href} />
      ))
    }
    {defaultAlternate && (
      <link rel="alternate" hreflang="x-default" href={defaultAlternate.href} />
    )}

    <meta property="og:site_name" content={t(lang, "brandName")} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:locale" content={lang === "en" ? "en_US" : "ru_RU"} />
    <meta property="og:url" content={canonicalHref} />
    <meta property="og:image" content={ogImageHref} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageHref} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <Analytics />

    <script is:inline>
      // Тема до первой отрисовки: тёмная по умолчанию, сохранённая важнее
      // системной. Скрипт инлайновый и обязан быть в <head> — иначе страница
      // успевает мигнуть кремовым.
      (function () {
        var root = document.documentElement;
        var meta = document.querySelector('meta[name="theme-color"]');
        var COLORS = { dark: "#1400c3", light: "#f4efca", cyberpunk: "#171717" };
        var theme = "dark";
        try {
          if (window.matchMedia("(prefers-color-scheme: light)").matches) theme = "light";
          var saved = localStorage.getItem("theme");
          if (saved === "dark" || saved === "light" || saved === "cyberpunk") theme = saved;
        } catch (error) {
          /* приватный режим — живём на дефолте */
        }
        root.setAttribute("data-theme", theme);
        // Маркер для CSS: без него нельзя отличить «JS ещё не было» от «JS выключен»,
        // а от этого зависит кламп тезисов (см. `program.css`).
        root.setAttribute("data-js", "on");
        if (meta) meta.setAttribute("content", COLORS[theme] || COLORS.dark);

        // Иконка тумблера берётся из карты, которую рендерит `Nav.astro`
        // (`data-theme-icons`), — строки иконок не дублируются. Без этого
        // светлая системная тема показывала бы луну до старта клиентского
        // модуля, а на 404 без модуля — всё время.
        var paintIcon = function () {
          var holder = document.querySelector("[data-theme-icons]");
          if (!holder) return;
          var icons;
          try {
            icons = JSON.parse(holder.getAttribute("data-theme-icons") || "{}");
          } catch (error) {
            return;
          }
          var d = icons[root.getAttribute("data-theme") || "dark"];
          if (!d) return;
          document.querySelectorAll("[data-theme-toggle] path").forEach(function (path) {
            path.setAttribute("d", d);
          });
        };
        document.addEventListener("DOMContentLoaded", paintIcon);
      })();
    </script>
  </head>

  <body>
    {/* Свечение земли — второй слой фона (`tokens.css`, `.ground-bloom`).
        Стоит первым ребёнком `body` намеренно: у всех трёх декоративных слоёв
        один `z-index` (−1), поэтому порядок отрисовки задаёт порядок в дереве, и
        свет обязан оказаться между рампой (`body::before`) и сотами
        (`body::after`), а не над узором. Пустой декоративный узел: он не несёт
        текста, кликов не ловит и в дерево доступности не попадает. */}
    <div class="ground-bloom" aria-hidden="true"></div>

    <a class="skip-link" href="#main">{t(lang, "skipLink")}</a>

    {/* Поиск и избранное есть только на страницах дня: у 404 нет ни диалога,
        ни клиентского скрипта, и кнопка-фильтр осталась бы мёртвой. */}
    <Nav
      ordinal={dayOrdinal}
      lang={lang}
      search={Boolean(dayOrdinal)}
      favorites={Boolean(dayOrdinal)}
      tracks={Boolean(dayOrdinal)}
      page={page}
      langHref={alternatePath ? `${BASE_URL}${alternatePath}` : undefined}
    />

    <main id="main" class="page" tabindex="-1">
      <slot />
    </main>

    <footer class="site-footer">
      {/* Записка автора стоит первой строкой подвала: дальше идут контакты и
          правовая сноска, и предложение не должно читаться их продолжением. */}
      <CollabCta lang={lang} />
      <p class="site-footer__contacts">
        <a
          class="footer-contact social-link--telegram"
          href="https://t.me/lofinibo"
          target="_blank"
          rel="noopener">Telegram</a
        >
        <a
          class="footer-contact social-link--github"
          href="https://github.com/NikitaBoyarkin"
          target="_blank"
          rel="noopener">GitHub</a
        >
        <a
          class="footer-contact social-link--linkedin"
          href="https://www.linkedin.com/in/nikita-boyarkin"
          target="_blank"
          rel="noopener">LinkedIn</a
        >
      </p>
      <p>
        {sourceBefore}<a
          href="https://lms.matemarketing.ru/events/all/6/program"
          target="_blank"
          rel="noopener">{t(lang, "footerSourceLink")}</a>{sourceAfter}
      </p>
      <p>
        {ticketsBefore}<a href="https://matemarketing.ru/tickets/" target="_blank" rel="noopener"
          >{t(lang, "footerTicketsLink")}</a
        >{ticketsAfter}
      </p>
      <p>{t(lang, "footerRights")}</p>
      <p class="site-footer__note">{t(lang, "footerNote")}</p>
    </footer>

    <script is:inline>
      // Фолбэк для страниц без клиентского скрипта (404): тема и drawer.
      // На странице программы `data-day-id` есть, и тем же занимается
      // `src/scripts/program-client.ts` — два слушателя на одну кнопку
      // проматывали бы тему через шаг.
      if (!document.documentElement.dataset.dayId) {
        // Тема: dark → light → cyberpunk → dark.
        (function () {
          var root = document.documentElement;
          var meta = document.querySelector('meta[name="theme-color"]');
          var COLORS = { dark: "#1400c3", light: "#f4efca", cyberpunk: "#171717" };
          var ORDER = ["dark", "light", "cyberpunk"];
          var holder = document.querySelector("[data-theme-icons]");
          var ICONS = {};
          try {
            ICONS = JSON.parse((holder && holder.getAttribute("data-theme-icons")) || "{}");
          } catch (error) {
            /* без карты остаётся иконка из разметки */
          }
          var paintIcon = function (name) {
            var d = ICONS[name];
            if (!d) return;
            document.querySelectorAll("[data-theme-toggle] path").forEach(function (path) {
              path.setAttribute("d", d);
            });
          };
          document.querySelectorAll("[data-theme-toggle]").forEach(function (button) {
            button.addEventListener("click", function () {
              var current = root.getAttribute("data-theme") || "dark";
              var next = ORDER[(ORDER.indexOf(current) + 1) % ORDER.length];
              root.setAttribute("data-theme", next);
              if (meta) meta.setAttribute("content", COLORS[next] || COLORS.dark);
              // Модуля программы здесь нет, морфа тоже: иконку меняем руками,
              // иначе кнопка врала бы о теме (было так на 404).
              paintIcon(next);
              try {
                localStorage.setItem("theme", next);
              } catch (error) {
                /* приватный режим — тема живёт до перезагрузки */
              }
            });
          });
        })();

        // Drawer. Один делегированный слушатель: кнопка в шапке, крестик в
        // панели и подложка — три элемента с одним контрактом `data-nav-*`.
        (function () {
          var nav = document.getElementById("site-nav");
          var toggle = document.querySelector("[data-nav-open]");
          if (!nav || !toggle) return;

          // Подписи приходят из словаря через `data-label-*`: инлайновый скрипт
          // не знает языка страницы, а русские строки остаются фолбэком.
          var labelOpen = toggle.getAttribute("data-label-open") || "Открыть меню";
          var labelClose = toggle.getAttribute("data-label-close") || "Закрыть меню";

          var isOpen = function () {
            return document.body.classList.contains("nav-open");
          };

          var setOpen = function (open) {
            var hadFocus = nav.contains(document.activeElement);
            document.body.classList.toggle("nav-open", open);
            toggle.setAttribute("aria-expanded", String(open));
            toggle.setAttribute("aria-label", open ? labelClose : labelOpen);
            // `visibility: hidden` уже убирает панель из таб-порядка, `inert`
            // добавляет то же самое для скринридеров и старых движков.
            if (open) nav.removeAttribute("inert");
            else nav.setAttribute("inert", "");
            if (open) {
              var first = nav.querySelector("a, button");
              if (first) first.focus();
            } else if (hadFocus) {
              toggle.focus();
            }
          };

          document.addEventListener("click", function (event) {
            var target = event.target;
            if (!(target instanceof Element)) return;
            if (target.closest("[data-nav-open]")) {
              setOpen(true);
              return;
            }
            if (target.closest("[data-nav-close]")) {
              setOpen(false);
              return;
            }
            if (isOpen() && target.closest(".drawer-link")) setOpen(false);
          });

          document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && isOpen()) setOpen(false);
          });

          nav.setAttribute("inert", "");
        })();
      }
    </script>
  </body>
</html>
